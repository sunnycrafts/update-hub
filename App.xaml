<Application x:Class="UpdateHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:UpdateHub.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusBrushConverter x:Key="StatusBrush" />
            <conv:PriorityBrushConverter x:Key="PriorityBrush" />
            <conv:ConfidenceWidthConverter x:Key="ConfidenceWidth" />
            <conv:CategoryBrushConverter x:Key="CategoryBrush" />
            <conv:SizeTierOpacityConverter x:Key="SizeStep" />
            <conv:BoolToVisibilityConverter x:Key="BoolVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
            <conv:NullToVisibilityConverter x:Key="NullVis" />
            <conv:AgeSegmentConverter x:Key="AgeSegment" />
            <conv:ConfidenceBrushConverter x:Key="ConfidenceBrush" />
            <conv:HealthBrushConverter x:Key="HealthBrush" />

            <!-- ==== Bright silver surface palette ====
                 A light app needs its depth to come from layering rather than from dark
                 fills: a soft silver page, white cards lifted off it with a hairline
                 border and a low shadow. -->
            <Color x:Key="PageTopColor">#F7F9FC</Color>
            <Color x:Key="PageBottomColor">#E7ECF3</Color>

            <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource PageTopColor}" Offset="0" />
                <GradientStop Color="{StaticResource PageBottomColor}" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#D8DEE8" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="InkBrush" Color="#1B2430" />
            <SolidColorBrush x:Key="MutedInkBrush" Color="#5C6675" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />

            <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="1"
                              Direction="270" Opacity="0.13" Color="#5A6B85" />

            <!-- Left-nav item: full-width toggle that highlights when selected. -->
            <Style x:Key="NavItemStyle" TargetType="RadioButton">
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E3EAF4" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Surface card used across every page. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                <Setter Property="Margin" Value="0,12,0,2" />
            </Style>

            <Style x:Key="FieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Category chip: glyph plus muted text, deliberately colourless. -->
            <Style x:Key="CategoryGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </Style>

            <!-- Six-segment age gauge, drawn rather than typed. -->
            <DataTemplate x:Key="AgeGaugeTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,2,0"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=1}" />
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,2,0"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=2}" />
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,2,0"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=3}" />
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,2,0"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=4}" />
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,2,0"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=5}" />
                    <Rectangle Width="11" Height="9" RadiusX="2" RadiusY="2"
                               Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                               Opacity="{Binding Age.Band, Converter={StaticResource AgeSegment},
                                         ConverterParameter=6}" />
                </StackPanel>
            </DataTemplate>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Extended" />
                <Setter Property="RowHeight" Value="42" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
