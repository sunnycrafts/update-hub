<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Assertion harness for the logic that has to stay correct: calendar arithmetic,
    version comparison, name normalisation and the dedupe tolerances.

    Deliberately a plain console app rather than a test framework. It compiles the same
    source files the application uses — no duplication, no mocks — targets plain net8.0
    so it runs anywhere, and exits non-zero on failure so CI or a script can gate on it.

    Run it with "dotnet run" from this directory.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UpdateHub.Tests</AssemblyName>
    <RootNamespace>UpdateHub.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />

    <!-- Only the files whose logic is under test, so this stays free of WPF and Windows
         dependencies and can run on any runtime. -->
    <Compile Include="..\..\Core\VersionComparer.cs" />
    <Compile Include="..\..\Core\NameNormalizer.cs" />
    <Compile Include="..\..\Core\Scanning\WingetScanner.cs" />
    <Compile Include="..\..\Core\Scanning\IAppScanner.cs" />
    <Compile Include="..\..\Core\ProcessRunner.cs" />
    <Compile Include="..\..\Models\AgeBehind.cs" />
    <Compile Include="..\..\Models\Enums.cs" />

    <!-- InstalledApp pulls in the classifier and priority rules, which are pure logic and
         worth having compiled here even though the current assertions exercise them only
         indirectly. -->
    <Compile Include="..\..\Models\InstalledApp.cs" />
    <Compile Include="..\..\Core\AppClassifier.cs" />
    <Compile Include="..\..\Core\PriorityCalculator.cs" />
    <Compile Include="..\..\Core\SearchQuery.cs" />
    <Compile Include="..\..\Core\LaunchOptions.cs" />
    <Compile Include="..\..\Core\DriverScanner.cs" />
    <Compile Include="..\..\Core\DriverInstaller.cs" />

    <!-- ElevatedUpdateRunner's pure status-mapping logic (InterpretStatus /
         DescribeOutcome) is worth testing directly against the JSON shape the embedded
         PowerShell script actually emits. -->
    <Compile Include="..\..\Core\ElevatedUpdateRunner.cs" />
    <Compile Include="..\..\Services\LogService.cs" />
  </ItemGroup>

</Project>
