<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon, which provides native shell notifications without
         requiring a registered AppUserModelID the way WinRT toasts do. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UpdateHub</AssemblyName>
    <RootNamespace>UpdateHub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UpdateHub.ico</ApplicationIcon>
    <Version>0.8.0</Version>
    <Company>UpdateHub</Company>
    <Product>UpdateHub</Product>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Portable single-file publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WFAC010 asks for WinForms' high-DPI API instead of manifest settings, but this is
         a WPF app that only references WinForms for the tray icon; the manifest entries
         are the correct way to declare PerMonitorV2 for WPF. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds this to the implicit usings, where it collides with
         System.Windows.Application. NotificationService imports it explicitly instead. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test harness compiles a subset of these same sources; keep it out of the app. -->
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <Resource Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also as a resource so the window and title bar can load it at runtime; the
         ApplicationIcon above only sets the icon baked into the executable. -->
    <Resource Include="Assets\UpdateHub.ico" />
    <EmbeddedResource Include="Data\catalog.json" />
  </ItemGroup>

</Project>
