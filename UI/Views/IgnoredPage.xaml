<UserControl x:Class="UpdateHub.UI.Views.IgnoredPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:UpdateHub.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,10">
            <StackPanel>
                <TextBlock Text="Ignored" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Apps excluded from update checks. Right-click to restore one."
                           FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
            </StackPanel>
            <ui:Button Content="Stop ignoring" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Command="{Binding ToggleIgnoreCommand}" />
        </Grid>

        <views:AppListView Grid.Row="1" />
    </Grid>
</UserControl>
