<ui:FluentWindow x:Class="UpdateHub.UI.Views.LaunchOptionsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Launch options"
                 Width="470" Height="640"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Launch options" Icon="{x:Null}" ShowMaximize="False"
                     ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,6,18,10">
                <TextBlock x:Name="AppName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ExeText" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Margin="0,3,0,0" />

                <TextBlock Text="RUN AS" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                           Margin="0,16,0,4" />
                <CheckBox x:Name="AdminBox" Content="Always run this program as administrator"
                          ToolTip="Windows asks for approval each time the program starts, from any shortcut." />

                <TextBlock Text="COMPATIBILITY MODE" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                           Margin="0,16,0,4" />
                <ComboBox x:Name="CompatBox" HorizontalAlignment="Stretch"
                          ToolTip="Make Windows pretend to be an older version for this program. Useful for old games and tools that will not start." />

                <TextBlock Text="DISPLAY" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                           Margin="0,16,0,4" />
                <CheckBox x:Name="FullscreenBox" Content="Disable fullscreen optimizations"
                          ToolTip="Fixes stutter or flicker in some games and older fullscreen programs." />
                <CheckBox x:Name="DpiBox" Content="Override high DPI scaling (program handles it)" Margin="0,4,0,0"
                          ToolTip="Fixes blurry text on high resolution screens for some older programs." />
                <CheckBox x:Name="ColorBox" Content="Reduced colour mode (256 colours)" Margin="0,4,0,0"
                          ToolTip="For very old programs that expect an 8-bit display." />
                <CheckBox x:Name="ResBox" Content="Run in 640 x 480 screen resolution" Margin="0,4,0,0"
                          ToolTip="For very old programs that expect a tiny screen." />

                <TextBlock Text="SHORTCUT KEY" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                           Margin="0,16,0,4" />
                <ui:TextBox x:Name="HotkeyBox" PlaceholderText="for example CTRL+ALT+F"
                         ToolTip="Opens this program from anywhere in Windows. Use at least two of CTRL, ALT and SHIFT plus a letter, number or F-key. Leave empty for none." />
                <TextBlock x:Name="HotkeyNote" FontSize="11" Opacity="0.65" TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Saved on a Start Menu shortcut of your own, which is created if the program has none. It works even when UpdateHub is closed." />

                <TextBlock x:Name="Status" FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="18,10,18,16">
            <ui:Button Content="Open now" Click="OpenNow_Click" Margin="0,0,8,6"
                       ToolTip="Save the options above and start the program now." />
            <ui:Button Content="Open as administrator" Click="OpenAdmin_Click" Margin="0,0,8,6"
                       ToolTip="Start the program now with administrator rights, just this once." />
            <ui:Button Content="Save" Appearance="Primary" Click="Save_Click" Margin="0,0,8,6" MinWidth="80"
                       ToolTip="Store these options and the shortcut key." />
            <ui:Button Content="Close" Click="Close_Click" Margin="0,0,0,6" MinWidth="80" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
