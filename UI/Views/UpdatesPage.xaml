<UserControl x:Class="UpdateHub.UI.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:UpdateHub.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,10">
            <StackPanel>
                <TextBlock Text="Updates" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}">
                    <Run Text="{Binding NeedUpdate, Mode=OneWay}" />
                    <Run Text="applications have a newer version available" />
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="Export…" Click="Export_Click" Margin="0,0,8,0" />
                <ui:Button Content="Refresh all" Command="{Binding RefreshAllCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Update all" Appearance="Primary"
                           Command="{Binding UpdateAllCommand}" />
            </StackPanel>
        </Grid>

        <views:AppListView Grid.Row="1" />
    </Grid>
</UserControl>
