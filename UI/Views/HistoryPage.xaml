<UserControl x:Class="UpdateHub.UI.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,10">
            <StackPanel>
                <TextBlock Text="History" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Every update UpdateHub has attempted on this machine."
                           FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
            </StackPanel>
            <ui:Button Content="Clear history" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Click="Clear_Click" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4,8">
            <Grid>
                <TextBlock Text="No updates have been run yet."
                           Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding History.Count, Converter={StaticResource NullVis},
                                        ConverterParameter=invert}" />

                <DataGrid ItemsSource="{Binding History}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="150"
                                            Binding="{Binding StartedAt, StringFormat='d MMM yyyy HH:mm'}" />
                        <DataGridTextColumn Header="Application" Width="2*" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="From" Width="130" Binding="{Binding FromVersion}" />
                        <DataGridTextColumn Header="To" Width="130" Binding="{Binding ToVersion}" />
                        <DataGridTextColumn Header="Method" Width="100" Binding="{Binding Method}" />
                        <DataGridTextColumn Header="Took" Width="70" Binding="{Binding Duration}" />
                        <DataGridTextColumn Header="Result" Width="120" Binding="{Binding OutcomeText}" />
                        <DataGridTextColumn Header="Detail" Width="2*" Binding="{Binding Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
