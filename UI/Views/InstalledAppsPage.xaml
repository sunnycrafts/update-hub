<UserControl x:Class="UpdateHub.UI.Views.InstalledAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:UpdateHub.UI.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,10">
            <StackPanel>
                <TextBlock Text="Applications" FontSize="28" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock FontSize="12" Foreground="{StaticResource MutedInkBrush}">
                    <Run Text="{Binding ResultCountText, Mode=OneWay}" />
                    <Run Text="  ·  double-click a row to update it" />
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="SortBox" Width="132" Margin="0,0,8,0"
                          SelectionChanged="Sort_Changed" SelectedIndex="0"
                          ToolTip="Sort order">
                    <ComboBoxItem Content="By priority" Tag="priority" />
                    <ComboBoxItem Content="By name" Tag="name" />
                    <ComboBoxItem Content="By age" Tag="age" />
                    <ComboBoxItem Content="By size" Tag="size" />
                </ComboBox>
                <ComboBox x:Name="FilterBox" Width="150" Margin="0,0,8,0"
                          SelectionChanged="Filter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="All apps" Tag="all" />
                    <ComboBoxItem Content="Needs attention" Tag="attention" />
                    <ComboBoxItem Content="Needs updating" Tag="updates" />
                    <ComboBoxItem Content="Up to date" Tag="current" />
                    <ComboBoxItem Content="No source known" Tag="unknown" />
                </ComboBox>
                <ui:Button Content="Export…" Click="Export_Click" Margin="0,0,8,0" />
                <ui:Button Content="Update all" Appearance="Primary"
                           Command="{Binding UpdateAllCommand}" />
            </StackPanel>
        </Grid>

        <views:AppListView Grid.Row="1" />
    </Grid>
</UserControl>
