<UserControl x:Class="UpdateHub.UI.Views.AppListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="356" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- ===== Table ===== -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="6,10">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding AppsView}"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                      SelectionMode="Extended"
                      MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <!-- Priority leads: this is the answer to "what needs attention". -->
                    <DataGridTemplateColumn Header="Priority" Width="104" SortMemberPath="Priority">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="7,3" MinWidth="80"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding Priority,
                                                     Converter={StaticResource PriorityBrush}}">
                                    <TextBlock Text="{Binding PriorityText}" FontSize="10"
                                               FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Program" Width="2*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                               Margin="2,5,9,5"
                                               Fill="{Binding Category,
                                                      Converter={StaticResource CategoryBrush}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Style="{StaticResource CategoryGlyphStyle}"
                                                       Text="{Binding CategoryGlyph}"
                                                       ToolTip="{Binding CategoryText}" />
                                            <TextBlock Text="{Binding Publisher}" FontSize="10.5"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Installed" Width="110"
                                            SortMemberPath="InstalledVersion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InstalledVersion}" FontSize="12"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InstalledReleaseText}" FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Latest" Width="110" SortMemberPath="LatestVersion">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LatestVersion, TargetNullValue='—'}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LatestReleaseText}" FontSize="10"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- The signature column: how far behind, as a gauge plus words. -->
                    <DataGridTemplateColumn Header="Behind by" Width="120"
                                            SortMemberPath="Age.TotalDays">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <ContentPresenter Content="{Binding}"
                                                      ContentTemplate="{StaticResource AgeGaugeTemplate}" />
                                    <TextBlock Text="{Binding Age.Short}" FontSize="11"
                                               Margin="0,3,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Size" Width="86" SortMemberPath="EstimatedSizeKb">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SizeText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Rectangle Width="5" Height="7" RadiusX="1" RadiusY="1"
                                                   Margin="0,0,2,0" Fill="#8A93A0"
                                                   Opacity="{Binding SizeTier,
                                                             Converter={StaticResource SizeStep},
                                                             ConverterParameter=1}" />
                                        <Rectangle Width="5" Height="7" RadiusX="1" RadiusY="1"
                                                   Margin="0,0,2,0" Fill="#8A93A0"
                                                   Opacity="{Binding SizeTier,
                                                             Converter={StaticResource SizeStep},
                                                             ConverterParameter=2}" />
                                        <Rectangle Width="5" Height="7" RadiusX="1" RadiusY="1"
                                                   Margin="0,0,2,0" Fill="#8A93A0"
                                                   Opacity="{Binding SizeTier,
                                                             Converter={StaticResource SizeStep},
                                                             ConverterParameter=3}" />
                                        <Rectangle Width="5" Height="7" RadiusX="1" RadiusY="1"
                                                   Fill="#8A93A0"
                                                   Opacity="{Binding SizeTier,
                                                             Converter={StaticResource SizeStep},
                                                             ConverterParameter=4}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Confidence" Width="86" SortMemberPath="Confidence">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}"
                                               FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <Border Width="62" Height="5" CornerRadius="2.5" Margin="0,3,0,0"
                                            HorizontalAlignment="Left" Background="#E4E9F0">
                                        <Border HorizontalAlignment="Left" CornerRadius="2.5"
                                                Width="{Binding Confidence,
                                                        Converter={StaticResource ConfidenceWidth}}"
                                                Background="{Binding Confidence,
                                                             Converter={StaticResource ConfidenceBrush}}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Update now" Click="Update_Click" />
                        <MenuItem Header="Refresh this app"
                                  Command="{Binding RefreshSelectedCommand}" />
                        <Separator />
                        <MenuItem Header="Skip this version"
                                  Command="{Binding SkipVersionCommand}" />
                        <MenuItem Header="Ignore / un-ignore"
                                  Command="{Binding ToggleIgnoreCommand}" />
                        <Separator />
                        <MenuItem Header="Roll back to an earlier version…"
                                  Click="Rollback_Click" />
                        <MenuItem Header="Uninstall…" Click="Uninstall_Click" />
                        <Separator />
                        <MenuItem Header="Verify digital signature" Click="Verify_Click" />
                        <MenuItem Header="Open homepage" Click="Homepage_Click" />
                        <MenuItem Header="Open install folder" Click="Folder_Click" />
                        <MenuItem Header="Copy details" Click="Copy_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center"
                      Background="Transparent" />

        <!-- ===== Detail pane ===== -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <Grid>
                <TextBlock Text="Select an application to see its version history."
                           Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding SelectedApp, Converter={StaticResource NullVis},
                                        ConverterParameter=invert}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedApp, Converter={StaticResource NullVis}}">
                    <StackPanel>
                        <StackPanel DataContext="{Binding SelectedApp}">
                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Publisher}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />

                            <!-- Current status, stated the way Windows Settings would. -->
                            <Border Margin="0,14,0,0" CornerRadius="7" Padding="12,9"
                                    Background="{Binding Priority,
                                                 Converter={StaticResource PriorityBrush}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PriorityText}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding PriorityReason}" FontSize="11"
                                               Foreground="White" Opacity="0.9"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- The headline claim. -->
                            <Border Margin="0,10,0,0" CornerRadius="8" Padding="14"
                                    Background="{StaticResource SubtleBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="INSTALLED" FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Text="{Binding InstalledVersion}" FontSize="16"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding InstalledReleaseText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="LATEST" FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Text="{Binding LatestVersion,
                                                              TargetNullValue='Unknown'}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding LatestReleaseText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,12" Opacity="0.3" />

                                    <TextBlock Text="YOU ARE" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                    <ItemsControl ItemsSource="{Binding Age.Stacked}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="22"
                                                           FontWeight="Light"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="behind." FontSize="12" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLED ON THIS PC" />
                            <TextBlock Style="{StaticResource FieldValue}"
                                       Text="{Binding InstallDate, StringFormat='d MMMM yyyy',
                                              TargetNullValue='Unknown'}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="RELEASES MISSED" />
                            <TextBlock Style="{StaticResource FieldValue}">
                                <Run Text="{Binding ReleasesMissed, Mode=OneWay}" />
                                <Run Text="releases," />
                                <Run Text="{Binding SecurityReleasesMissed, Mode=OneWay}" />
                                <Run Text="flagged as security fixes" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="VERSIONS BEHIND" />
                            <TextBlock Style="{StaticResource FieldValue}">
                                <Run Text="{Binding MajorVersionsBehind, Mode=OneWay}" />
                                <Run Text="major," />
                                <Run Text="{Binding MinorVersionsBehind, Mode=OneWay}" />
                                <Run Text="minor" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="UPDATE CONFIDENCE" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,10,0"
                                           Text="{Binding Confidence, StringFormat={}{0}%}"
                                           Foreground="{Binding Confidence,
                                                        Converter={StaticResource ConfidenceBrush}}" />
                                <Border Grid.Column="1" Height="6" CornerRadius="3"
                                        VerticalAlignment="Center" Background="#E4E9F0">
                                    <Border HorizontalAlignment="Left" CornerRadius="3"
                                            Width="{Binding Confidence,
                                                    Converter={StaticResource ConfidenceWidth}}"
                                            Background="{Binding Confidence,
                                                         Converter={StaticResource ConfidenceBrush}}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ConfidenceNote}" FontSize="11"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding ConfidenceNote,
                                                    Converter={StaticResource NullVis}}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="SOURCES" />
                            <ItemsControl ItemsSource="{Binding ConfidenceSources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="7,2" Margin="0,0,5,5"
                                                Background="{StaticResource SubtleBrush}"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{StaticResource InkBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORY / SIZE" />
                            <TextBlock Style="{StaticResource FieldValue}">
                                <Run Text="{Binding CategoryText, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="UPDATE METHOD" />
                            <TextBlock Style="{StaticResource FieldValue}"
                                       Text="{Binding UpdateMethod}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="WINGET PACKAGE"
                                       Visibility="{Binding WingetId,
                                                    Converter={StaticResource NullVis}}" />
                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding WingetId}"
                                       Visibility="{Binding WingetId,
                                                    Converter={StaticResource NullVis}}" />
                        </StackPanel>

                        <!-- ===== Version timeline ===== -->
                        <TextBlock Style="{StaticResource FieldLabel}" Text="VERSION TIMELINE"
                                   Visibility="{Binding SelectedHistory.Count,
                                                Converter={StaticResource NullVis}}" />
                        <ItemsControl ItemsSource="{Binding SelectedHistory}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Rail: a continuous line with a node per release. -->
                                        <Canvas Grid.Column="0" Width="16">
                                            <Line X1="8" Y1="0" X2="8" Y2="26" StrokeThickness="1.5"
                                                  Stroke="{StaticResource CardBorderBrush}" />
                                            <Ellipse Canvas.Left="4" Canvas.Top="8" Width="8" Height="8"
                                                     Fill="{StaticResource AccentBrush}" />
                                        </Canvas>

                                        <StackPanel Grid.Column="1" Margin="4,3,0,3">
                                            <TextBlock Text="{Binding Version}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       Text="{Binding ReleaseDate,
                                                              StringFormat='d MMM yyyy',
                                                              TargetNullValue='date unknown'}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" CornerRadius="3" Padding="5,1"
                                                VerticalAlignment="Center" Background="#C0392B"
                                                Visibility="{Binding IsSecurityRelease,
                                                             Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="security" FontSize="9"
                                                       FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
