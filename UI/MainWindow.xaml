<ui:FluentWindow x:Class="UpdateHub.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="UpdateHub"
                 Icon="pack://application:,,,/Assets/UpdateHub.ico"
                 Width="1460" Height="920"
                 MinWidth="1120" MinHeight="660"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="UpdateHub">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/UpdateHub.ico"
                              Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="UpdateHub" Foreground="{StaticResource InkBrush}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0" Margin="10,0,0,10" Padding="8"
                    Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <ui:TextBox x:Name="SearchBox" Margin="2,2,2,4"
                                    PlaceholderText="Search or filter  (Ctrl+F)"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="4,0,4,10" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   Text="Try: security · behind&gt;365 · publisher:Microsoft · size&gt;2GB" />

                        <RadioButton Content="Home" GroupName="nav" Tag="dashboard"
                                     Style="{StaticResource NavItemStyle}" IsChecked="True"
                                     Checked="Nav_Checked" />
                        <RadioButton x:Name="NavUpdates" GroupName="nav" Tag="updates"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavApps" GroupName="nav" Tag="apps"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                        <RadioButton Content="Drivers" GroupName="nav" Tag="drivers"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked"
                                     ToolTip="Check this PC's drivers and look for newer ones." />
                        <RadioButton Content="Insights" GroupName="nav" Tag="insights"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                        <RadioButton Content="History" GroupName="nav" Tag="history"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavIgnored" GroupName="nav" Tag="ignored"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                        <RadioButton Content="Settings" GroupName="nav" Tag="settings"
                                     Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,4">
                        <ui:Button Command="{Binding ScanCommand}" Appearance="Primary"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                   Content="Scan now" />
                        <ui:Button Command="{Binding RefreshAllCommand}"
                                   HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                   Content="Refresh all" />
                        <ui:Button Command="{Binding CancelCommand}"
                                   HorizontalAlignment="Stretch"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                   Content="Cancel" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" Margin="10,0,10,10" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,7" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource InkBrush}" />
                    <ProgressBar Width="180" Height="4" Margin="14,0,0,0" VerticalAlignment="Center"
                                 Value="{Binding ProgressValue}" Maximum="100"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}">
                    <Run Text="GitHub API:" />
                    <Run Text="{Binding GitHubBudget, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
